# Postgres
DATABASE_URL="postgresql://budget:budget@localhost:5432/budget?schema=public"

# Google Sheets (сервис-аккаунт, только чтение таблицы)
BUDGET_SPREADSHEET_ID="<id таблицы из её URL>"
# Ключ сервис-аккаунта: base64 всего JSON (прод, из Infisical) ИЛИ путь к файлу (локально)
GOOGLE_SA_JSON_B64=""
# GOOGLE_SA_JSON_FILE="/app/sa.json"

# Auth (NextAuth v5)
AUTH_SECRET=""           # openssl rand -base64 32
AUTH_URL="https://budget.oresh.in"
ADMIN_EMAIL=""           # логин единственного пользователя
ADMIN_PASSWORD=""        # пароль (хешируется при сидировании; секрет из Infisical)

# Синхрон
SYNC_TOKEN=""            # токен для защиты /api/sync (Authorization: Bearer …)
SYNC_INTERVAL_MIN="10"   # период авто-синхрона в минутах (0 — выключить)
